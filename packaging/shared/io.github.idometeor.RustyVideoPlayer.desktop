[Desktop Entry]
Type=Application
Version=1.5
Name=Rusty Video Player
GenericName=Media Player
Comment=Play video and music with a library, a queue and a visualizer
Exec=rvp %U
TryExec=rvp
Icon=io.github.idometeor.RustyVideoPlayer
Terminal=false
StartupNotify=true
StartupWMClass=io.github.idometeor.RustyVideoPlayer
Categories=AudioVideo;Audio;Video;Player;
Keywords=video;audio;music;movie;player;media;mp4;mkv;webm;flac;mp3;opus;playlist;visualizer;
MimeType=video/mp4;video/x-m4v;video/x-matroska;video/webm;audio/x-matroska;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/vnd.wave;audio/x-wav;audio/wav;audio/aac;audio/mp4;audio/x-m4b;audio/x-mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;application/x-subrip;text/vtt;
