{
  "id": "io.github.idometeor.RustyWave",
  "name": "Rusty Wave",
  "short_name": "Rusty Wave",
  "description": "Play video and music: a library, a queue, subtitles and a visualizer. Works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07060d",
  "theme_color": "#07060d",
  "categories": ["music", "entertainment", "multimedia"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Media",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "accept": {
        "video/mp4": [".mp4", ".m4v"],
        "video/x-matroska": [".mkv"],
        "audio/x-matroska": [".mka"],
        "video/webm": [".webm"],
        "audio/mpeg": [".mp3"],
        "audio/flac": [".flac"],
        "audio/ogg": [".ogg", ".oga", ".opus"],
        "audio/wav": [".wav"],
        "audio/aac": [".aac"],
        "audio/mp4": [".m4a", ".m4b"],
        "audio/x-mpegurl": [".m3u", ".m3u8"],
        "audio/x-scpls": [".pls"]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-existing" },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["video/*", "audio/*", ".mkv", ".mka", ".flac", ".opus", ".m3u", ".m3u8", ".pls", ".srt", ".vtt"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "Music library", "short_name": "Library", "url": "./?face=library", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
